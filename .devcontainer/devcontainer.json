{
  "name": "ShopLink Data & Analytics Bootcamp",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },

  "forwardPorts": [8000, 5432, 8888, 8080, 4040, 9000, 9001, 9092, 3000, 8085, 5000],

  "portsAttributes": {
    "8000": { "label": "Course app preview", "onAutoForward": "openPreview" },
    "5432": { "label": "PostgreSQL (Weeks 1-3)" },
    "8888": { "label": "JupyterLab / Spark driver" },
    "8080": { "label": "Spark master UI" },
    "4040": { "label": "Spark application UI" },
    "9000": { "label": "MinIO S3 API" },
    "9001": { "label": "MinIO console" },
    "9092": { "label": "Kafka" },
    "3000": { "label": "Marquez lineage" },
    "8085": { "label": "Unity Catalog" },
    "5000": { "label": "OpenLineage API" }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install duckdb pandas pyarrow polars",

  "postAttachCommand": {
    "course-app": "nohup python -m http.server 8000 --bind 0.0.0.0 > /tmp/course-app.log 2>&1 &"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "redhat.vscode-yaml",
        "hashicorp.terraform"
      ]
    }
  },

  "remoteUser": "vscode"
}
